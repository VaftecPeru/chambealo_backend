APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# CONFIGURACIÓN DE PAGOS - MERCADOPAGO
# ============================================
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MIN_AMOUNT=0.01
MERCADOPAGO_MAX_AMOUNT=999999.99
MERCADOPAGO_TIMEOUT=30

# ============================================
# CONFIGURACIÓN DE PAGOS - IZIPAY
# ============================================
IZIPAY_ENV=sandbox
IZIPAY_CLIENT_ID=
IZIPAY_SECRET=
IZIPAY_PUBLIC_KEY=
IZIPAY_HASH_KEY=
IZIPAY_WEBHOOK_SECRET=
IZIPAY_URL=https://api.izipay.pe
IZIPAY_MIN_AMOUNT=0.01
IZIPAY_MAX_AMOUNT=999999.99
IZIPAY_TIMEOUT=30

# ============================================
# CONFIGURACIÓN DE PAGOS - PAYPAL
# ============================================
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MIN_AMOUNT=0.01
PAYPAL_MAX_AMOUNT=999999.99
PAYPAL_TIMEOUT=30

# ============================================
# CONFIGURACIÓN DE SEGURIDAD DE PAGOS
# ============================================
# Requerir HTTPS para webhooks en producción
PAYMENT_REQUIRE_HTTPS=true

# Ventana de validación de timestamp (segundos) - Anti-replay
PAYMENT_WEBHOOK_TIMESTAMP_WINDOW=300

# Rate limiting por IP para webhooks (requests/window)
PAYMENT_WEBHOOK_RATE_LIMIT_MAX=100
PAYMENT_WEBHOOK_RATE_LIMIT_WINDOW=60

# Prevención de replay attacks
PAYMENT_REPLAY_PREVENTION=true

# Almacenar logs de webhook en BD
PAYMENT_LOG_WEBHOOKS_DB=true

# ============================================
# CONFIGURACIÓN DE LOGGING DE PAGOS
# ============================================
# Canal de log para pagos (storage/logs/payment.log)
PAYMENT_LOG_CHANNEL=payment

# Log detallado de payloads (NUNCA en producción)
PAYMENT_LOG_WEBHOOK_PAYLOADS=false

# Log de intentos fallidos
PAYMENT_LOG_FAILED_ATTEMPTS=true

# ============================================
# CONFIGURACIÓN DE VALIDACIÓN (VAFTEC)
# ============================================
# Moneda predeterminada
PAYMENT_DEFAULT_CURRENCY=USD

# Monedas permitidas
PAYMENT_ALLOWED_CURRENCIES=USD,PEN,MXN,ARS,CLP,EUR

# Monto mínimo global
PAYMENT_MIN_AMOUNT=0.01

# Monto máximo global
PAYMENT_MAX_AMOUNT=999999.99

# ============================================
# REDIRECCIONES DE PAGO
# ============================================
PAYMENT_REDIRECT_SUCCESS=/payment/success
PAYMENT_REDIRECT_CANCEL=/payment/cancel
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# PDF & Email Configuration
PDF_STORAGE_PATH=storage/invoices
INVOICE_COMPANY_NAME=VAFTEC PERÚ SAC
INVOICE_COMPANY_TAX_ID=
INVOICE_COMPANY_EMAIL=facturación@vaftec.com

# Queue Configuration
QUEUE_CONNECTION=database
QUEUE_DRIVER=database